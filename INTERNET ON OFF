 private void BlockInternetAccess(string HDplayer)
 {
     Process.Start("netsh.exe", $"advfirewall firewall add rule name=\"Block {HDplayer}\" dir=out action=block program=\"{HDplayer}\" enable=yes");

     UpdateStatus("INTERNET BLOCK ON !!");
     Console.Beep(400, 300);
 }

 private void AllowInternetAccess(string HDplayer)
 {
     Process.Start("netsh.exe", $"advfirewall firewall delete rule name=\"Block {HDplayer}\"");
     UpdateStatus("INTERNET BLOCK OFF !!");
     Console.Beep(400, 300);
 }

